{
  "name": "tui",
  "private": true,
  "type": "module",
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@tsconfig/bun": "^1.0.7",
    "fuzzysort": "^3.1.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --conditions browser --no-compile-autoload-bunfig --no-compile-autoload-dotenv src/index.tsx --outfile dist/agent-tui.exe"
  }
}