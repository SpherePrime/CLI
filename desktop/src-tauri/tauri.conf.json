{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prime Desktop",
  "mainBinaryName": "PrimeDesktop",
  "version": "0.4.75",
  "identifier": "io.sphereprime.native-preview",
  "build": {
    "frontendDist": "../out/native-renderer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run native:dev:prepare",
    "beforeBuildCommand": "npm run native:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prime Desktop",
        "width": 1440,
        "height": 940,
        "minWidth": 420,
        "minHeight": 420,
        "decorations": false,
        "backgroundColor": "#111318",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data:; media-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "engine/"
    ],
    "icon": [
      "../build/icon.png",
      "../build/icon.ico"
    ],
    "publisher": "SpherePrime",
    "copyright": "SpherePrime",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "../build/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEODlBMUIxRjU3REJBRjcKUldUM3VuMzFzYUdKWGRtMWR2NXZqeFBJSThOU2ZwOHBvYkpmb0Nnb3Vaa2dYRldMRG5zcmZzZnAK",
      "endpoints": [
        "https://github.com/SpherePrime/CLI/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
