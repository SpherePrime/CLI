{
  "name": "prime-desktop",
  "version": "0.4.53",
  "description": "Desktop workspace for Prime",
  "private": true,
  "author": "SpherePrime",
  "homepage": "https://github.com/SpherePrime/CLI",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64 --config.directories.output=release/$npm_package_version",
    "runtime:verify": "node scripts/verify-runtime.mjs",
    "dist:installer": "node scripts/package-installer.mjs",
    "preview:shot": "node tests/fixtures/preview-shot.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.21",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.2",
    "electron-updater": "^6.6.2",
    "ignore": "^7.0.12",
    "koffi": "3.3.3",
    "lucide-react": "^0.468.0",
    "node-pty": "1.1.0",
    "onnxruntime-node": "1.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "1.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.8.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
