{
  "name": "prime-desktop",
  "version": "0.4.73",
  "description": "Desktop workspace for Prime",
  "private": true,
  "author": "SpherePrime",
  "homepage": "https://github.com/SpherePrime/CLI",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run native:ui",
    "preview": "vite preview --config vite.native.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "dist:win": "node scripts/build-native-installer.mjs nsis && node scripts/build-setup.mjs",
    "dist:linux": "node scripts/build-native-installer.mjs appimage,deb,rpm",
    "dist:installer": "node scripts/build-native-installer.mjs",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "native:prepare": "node scripts/build-desktop-engine.mjs && npm run native:ui",
    "native:ui": "tsc --noEmit && vite build --config vite.native.config.ts",
    "native:ui:dev": "vite --config vite.native.config.ts",
    "native:dev:prepare": "node scripts/build-desktop-engine.mjs && npm run native:ui:dev",
    "setup:ui": "vite build --config installer/vite.config.ts",
    "setup:ui:dev": "vite --config installer/vite.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
